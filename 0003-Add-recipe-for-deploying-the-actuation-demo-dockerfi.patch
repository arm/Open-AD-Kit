From 26e2e6e1b204dcdfcd1b441508d7b41c30d221c5 Mon Sep 17 00:00:00 2001
From: Julien Jayat <julien.jayat@arm.com>
Date: Mon, 9 Feb 2026 14:04:39 +0100
Subject: [PATCH] Add recipe for deploying the actuation demo dockerfiles

---
 .../actuation/actuation-module-demo.bb        | 29 ++++++++++++++++
 ...0001-Fix-Dockerfile-for-podman-build.patch | 34 +++++++++++++++++++
 2 files changed, 63 insertions(+)
 create mode 100644 yocto/meta-arm-auto-solutions/recipes-demos/actuation/actuation-module-demo.bb
 create mode 100644 yocto/meta-arm-auto-solutions/recipes-demos/actuation/files/0001-Fix-Dockerfile-for-podman-build.patch

diff --git a/yocto/meta-arm-auto-solutions/recipes-demos/actuation/actuation-module-demo.bb b/yocto/meta-arm-auto-solutions/recipes-demos/actuation/actuation-module-demo.bb
new file mode 100644
index 00000000..e5cdd4b4
--- /dev/null
+++ b/yocto/meta-arm-auto-solutions/recipes-demos/actuation/actuation-module-demo.bb
@@ -0,0 +1,29 @@
+#
+# SPDX-FileCopyrightText: <text>Copyright 2025 Arm Limited and/or its
+# affiliates <open-source-office@arm.com></text>
+#
+# SPDX-License-Identifier: MIT
+
+SUMMARY = "Actuation porting demo content"
+DESCRIPTION = "Installs the demo assets from the actuation_porting repository into /demo on the target root filesystem."
+HOMEPAGE = "https://github.com/oguzkaganozt/actuation_porting"
+LICENSE = "Apache-2.0"
+LIC_FILES_CHKSUM = "file://license.rst;md5=e805dc5353977631b7881c7705a6c04a"
+
+SRC_URI = "git://github.com/oguzkaganozt/actuation_porting.git;branch=main;protocol=https"
+SRCREV = "b728a5cfd3fe0d8c477dcaa148cf3cc6767dfa8c"
+
+
+FILESEXTRAPATHS:prepend := "${THISDIR}/files:"
+SRC_URI:append = " file://0001-Fix-Dockerfile-for-podman-build.patch"
+
+
+S = "${WORKDIR}/git"
+
+# Copy the repo's demo directory to /root/demo in the target rootfs
+do_install() {
+    install -d ${D}/root/demo
+    cp -r ${S}/demo/. ${D}/root/demo/
+}
+
+FILES:${PN} += "/root/demo"
diff --git a/yocto/meta-arm-auto-solutions/recipes-demos/actuation/files/0001-Fix-Dockerfile-for-podman-build.patch b/yocto/meta-arm-auto-solutions/recipes-demos/actuation/files/0001-Fix-Dockerfile-for-podman-build.patch
new file mode 100644
index 00000000..9e4e2020
--- /dev/null
+++ b/yocto/meta-arm-auto-solutions/recipes-demos/actuation/files/0001-Fix-Dockerfile-for-podman-build.patch
@@ -0,0 +1,34 @@
+From 08967956cccbac0e223e6aa5020cd706fcd2b001 Mon Sep 17 00:00:00 2001
+From: Julien Jayat <julien.jayat@arm.com>
+Date: Mon, 9 Feb 2026 11:27:24 +0100
+Subject: [PATCH] Fix Dockerfile for podman build
+
+The version of podman version used for the demo doesn't uses the SHELL
+variable as expected.
+
+Force use a bash in the command to avoid using sh.
+
+Upstream-Status: Pending
+---
+ demo/visualizer/Dockerfile | 4 ++--
+ 1 file changed, 2 insertions(+), 2 deletions(-)
+
+diff --git a/demo/visualizer/Dockerfile b/demo/visualizer/Dockerfile
+index 1d47af5..5fe3447 100644
+--- a/demo/visualizer/Dockerfile
++++ b/demo/visualizer/Dockerfile
+@@ -36,9 +36,9 @@ RUN openssl req -x509 -nodes -newkey rsa:2048 \
+   -subj "/O=Autoware-OpenADKit/CN=localhost"
+ 
+ # hadolint ignore=SC1091
+-RUN source /opt/autoware/setup.bash \
+-  && RVIZ_PATH="$(ros2 pkg prefix --share autoware_launch)/rviz" \
+-  && cp -r "$RVIZ_PATH" /autoware/rviz
++RUN  /bin/bash -c 'source /opt/autoware/setup.bash \
++  && RVIZ_PATH="$(ros2 pkg prefix --share autoware_launch)/rviz" \
++  && cp -r "$RVIZ_PATH" /autoware/rviz'
+ 
+ # Need to expose VNC and NoVNC ports when running the container
+ EXPOSE 5900 6080
+-- 
+2.34.1
-- 
2.34.1

