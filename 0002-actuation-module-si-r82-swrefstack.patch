+# affiliates <open-source-office@arm.com></text>
+#
+# SPDX-License-Identifier: MIT
+
+SUMMARY = "Actuation Module Zephyr application"
+DESCRIPTION = "Autoware MPC/PID actuation module running on Zephyr with CycloneDDS transport."
+HOMEPAGE = "https://github.com/autowarefoundation/autoware"
+LICENSE = "Apache-2.0"
+LIC_FILES_CHKSUM = "file://license.rst;md5=e805dc5353977631b7881c7705a6c04a"
+
+require recipes-kernel/zephyr-kernel/zephyr-sample.inc
+#require recipes-demos/actuation/actuation-common.inc
+require recipes-demos/actuation/cyclonedds_0.10.3.inc
+
+
+DEPENDS += "\
+    ament-cmake-auto-native \
+    ament-cmake-python-native \
+    ament-cmake-target-dependencies-native \
+    cyclonedds-native \
+    libeigen-native \
+"
+
+# /* cspell:disable-next-line */
+BRANCH_ACTUATION_MODULE = "branch=main"
+SRC_URI_ACTUATION_MODULE = "git://github.com/oguzkaganozt/actuation_porting.git;${BRANCH_ACTUATION_MODULE};protocol=https"
+SRCREV_ACTUATION_MODULE = "b728a5cfd3fe0d8c477dcaa148cf3cc6767dfa8c"
+
+SRC_URI:append = " ${SRC_URI_ACTUATION_MODULE};name=actuation-module;destsuffix=git/modules/lib/actuation_module"
+SRC_URI:append = " ${SRC_URI_CYCLONEDDS};name=cyclonedds;destsuffix=git/modules/lib/actuation_module/cyclonedds"
+
+SRCREV_actuation-module = "${SRCREV_ACTUATION_MODULE}"
+SRCREV_cyclonedds = "${SRCREV_CYCLONEDDS}"
+
+
+FILESEXTRAPATHS:prepend := "${THISDIR}/files:"
+
+SRC_URI:append = " file://0001-Remove-the-ZEPHYR_TARGET-check.patch;patchdir=modules/lib/actuation_module"
+SRC_URI:append = " file://0002-actuation-module-si-r82.patch;patchdir=modules/lib/actuation_module"
+
+# Default board (match existing demos)
+BOARD = "fvp_rd_kronos_safety_island_c2"
+ZEPHYR_BOARD = "${BOARD}"
+
+ZEPHYR_SRC_DIR = "${S}/modules/lib/actuation_module/actuation_module"
+
+OVERLAY_BASENAME_FILE = "${ZEPHYR_SAFETY_ISLAND_MODULE}/overlays/hipc/${BOARD}"
+OVERLAY_ACTUATION_BASENAME_FILE = "${ZEPHYR_SAFETY_ISLAND_MODULE}/apps/actuation/boards/${BOARD}_actuation"
+
+# Build-time switches for the test variants (match build.sh BUILD_TEST)
+# One “on” flag per test variant; no “off” flag
+PACKAGECONFIG ??= ""
+PACKAGECONFIG[unit-test]     = "-DBUILD_TEST=1,"
+PACKAGECONFIG[dds-publisher] = "-DBUILD_TEST=2,"
+PACKAGECONFIG[dds-subscriber]= "-DBUILD_TEST=3,"
+
+# Default to BUILD_TEST=0 when none of the above are selected
+EXTRA_OECMAKE:append = " \
+    -DCYCLONEDDS_SRC='${ZEPHYR_SRC_DIR}/../cyclonedds' \
+    -DDTC_OVERLAY_FILE='${OVERLAY_BASENAME_FILE}.overlay' \
+    -DOVERLAY_CONFIG='${OVERLAY_BASENAME_FILE}.conf;${OVERLAY_ACTUATION_BASENAME_FILE}.conf' \
+    ${@bb.utils.contains_any('PACKAGECONFIG', ['unit-test','dds-publisher','dds-subscriber'], '', '-DBUILD_TEST=0', d)} \
+    -DEXTRA_CFLAGS='-Wno-error' \
+    -DEXTRA_CXXFLAGS='-Wno-error' \
+"
