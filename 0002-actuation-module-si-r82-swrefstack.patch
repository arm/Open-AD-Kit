+From ee1cedf3dca0b018537fc4003c7eaaa70aa75f81 Mon Sep 17 00:00:00 2001
+From: Julien Jayat <julien.jayat@arm.com>
+Date: Thu, 11 Dec 2025 16:28:13 +0100
+Subject: [PATCH] Remove the ZEPHYR_TARGET check define fabsl in all cases
+
+Upstream-Status: Inappropriate [expanding workaround to all]
+---
+ actuation_module/CMakeLists.txt | 2 --
+ 1 file changed, 2 deletions(-)
+
+diff --git a/actuation_module/CMakeLists.txt b/actuation_module/CMakeLists.txt
+index 4aa7e31..fea92b3 100644
+--- a/actuation_module/CMakeLists.txt
++++ b/actuation_module/CMakeLists.txt
+@@ -60,12 +60,10 @@ message("App headers: ${APP_INCLUDE_DIRS}")
+ #   EIGEN_DONT_ALIGN_STATICALLY
+ # )
+ 
+-if(ZEPHYR_TARGET STREQUAL "fvp_baser_aemv8r_smp")
+ # NOTE: we dont have fabsl in zephyr for fvp builds, so we provide a substitute
+ target_compile_options(app PRIVATE 
+   "-Dfabsl(x)=((long double)fabs((double)(x)))"
+ )
+-endif()
+ 
+ target_include_directories(app PRIVATE
+   include
+-- 
+2.34.1
+
